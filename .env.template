# ============================================================
# .env.template — Copy this to .env and fill in your values
# Never commit .env to version control
# ============================================================

# --- OpenAI ---
OPENAI_API_KEY=sk-...your-openai-api-key-here...

# --- Redbubble Credentials ---
REDBUBBLE_EMAIL=your-redbubble-email@example.com
REDBUBBLE_PASSWORD=your-redbubble-password

# --- Optional: Leonardo AI (alternative image generator) ---
LEONARDO_API_KEY=your-leonardo-api-key

# --- Optional: Ideogram API ---
IDEOGRAM_API_KEY=your-ideogram-api-key

# --- Optional: Proxy (for scraping) ---
# HTTP_PROXY=http://user:pass@proxy-host:port
# HTTPS_PROXY=http://user:pass@proxy-host:port

# --- Google Trends (no key needed, uses pytrends) ---
# GOOGLE_TRENDS_GEO=US

# --- Notification (optional) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASSWORD=your-app-password
# NOTIFY_EMAIL=your@gmail.com
